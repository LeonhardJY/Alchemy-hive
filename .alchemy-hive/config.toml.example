# .alchemy-hive/config.toml.example
# 复制为 .alchemy-hive/config.toml 并填入你的模型配置

# 主模型：分析阶段（结构化提取性格/记忆）+ 兜底
[model]
base_url = "https://api.deepseek.com/v1"
api_key = ""
model = "deepseek-v4-flash"

# 可选：撰写阶段用更强模型（写出 persona 正文，质量更高）
# 填了就只用它写 persona，分析仍走 [model]；不填则撰写也用 [model]
# [build]
# base_url = "https://api.deepseek.com/v1"
# api_key = ""
# model = "deepseek-v4-pro"

# 可选：buzz-cli 直连建号的配置（用 alchemy-hive buzz-setup --channel <UUID> 自动生成）
# [buzz]
# channel = ""
# relay_url = "http://localhost:3000"

# 可选：采样策略（控制分析阶段的消息采样量，适配不同上下文窗口的模型）
# [sampling]
# recent = 1500      # 近期消息数（默认 1500）
# early = 300        # 早期消息数（默认 300）
# char_budget = 240000  # 总字符预算（默认 240K，小模型可降至 32000）
# per_msg_cap = 1000    # 单条消息截断上限（默认 1000）
# min_recent = 50       # 预算收缩时近期保底条数（默认 50）
